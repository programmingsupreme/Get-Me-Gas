{
  "$schema": "https://app.flightcontrol.dev/schema.json",
  "environments": [
    {
      "id": "vibecoded",
      "name": "VibeCoded",
      "region": "us-east-1",
      "source": {
        "pr": false,
        "branch": "main",
        "trigger": "push"
      },
      "services": [
        {
          "id": "api-KUG9c3",
          "name": "API",
          "target": {
            "type": "fargate"
          },
          "buildType": "nixpacks",
          "cpu": 1,
          "gpu": 0,
          "memory": 2,
          "ci": {
            "type": "ec2",
            "instanceStorage": 30,
            "storageThroughput": 125,
            "storageIops": 3000,
            "storageType": "gp3"
          },
          "containerInsights": false,
          "autoscalingEnabled": true,
          "minInstances": 1,
          "maxInstances": 1,
          "versionHistoryCount": 10,
          "basePath": "./backend",
          "startCommand": [
            "uvicorn server:app --host 0.0.0.0 --port $PORT"
          ],
          "privileged": false,
          "envVariables": {},
          "autoscaling": {
            "cpuThreshold": 70,
            "memoryThreshold": 70,
            "scaleInCooldownTimerSecs": 300,
            "scaleOutCooldownTimerSecs": 300,
            "requestsPerTarget": 500
          },
          "includeEnvVariablesInBuild": true,
          "logging": {
            "ecsLogsMetadataEnabled": false,
            "cloudwatchLogsEnabled": true,
            "envVariables": {}
          },
          "cloudfrontAutoCacheInvalidation": true,
          "ecsStopTimeoutSecs": 90,
          "healthCheckTimeoutSecs": 4,
          "healthCheckIntervalSecs": 5,
          "healthCheckPath": "/api/",
          "port": 3000,
          "stickySessionsEnabled": false,
          "stickySessionsDurationSecs": 86400,
          "originShieldEnabled": true,
          "deploy": {
            "type": "rolling"
          },
          "enableCloudfrontSwr": false,
          "type": "web"
        }
      ]
    }
  ]
}
